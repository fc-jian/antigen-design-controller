# Environments, build output and local tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
node_modules/
.tmp*/
*.log
*.tmp
*.lock
!.github/**

# All deployment settings are private. Commit only templates/examples.
/configs/webapp.yaml
/configs/web-resources*.json
/configs/web-resource-limits*.json
/configs/gpu-targets.yaml
/configs/servers/*.yaml
!/configs/servers/*template.yaml
*.local.yaml
*.local.yml
*.local.json

# User inputs, runs, receipts, outputs and evidence are private by default.
/projects/*
!/projects/README.md
!/projects/1ubq/
/projects/1ubq/*
!/projects/1ubq/README.md
!/projects/1ubq/inputs/
!/projects/1ubq/configs/
/projects/1ubq/inputs/*
!/projects/1ubq/inputs/1ubq.cif
!/projects/1ubq/inputs/1ubq.provenance.json
/projects/1ubq/configs/*
!/projects/1ubq/configs/ubiquitin.yaml
!/projects/1ubq/configs/ubiquitin-p3.yaml
!/projects/1ubq/configs/ubiquitin-matrix.yaml
!/projects/1ubq/configs/screening-example.json
runs/
evidence/

# Authentication material and downloaded models/data
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
credentials.json
*.pt
